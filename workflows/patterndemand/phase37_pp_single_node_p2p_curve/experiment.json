  "payload_basis": "Phase34 PP Hfull已打开数据的非空12-bin每调用payload范围约4KiB至39.5MiB；使用2次幂、约P25/P50/P75/P90/P95/max锚点并扩至64MiB",
  "warmup_iterations": 30,
  "timed_iterations": 100,
  "minimum_independent_repeats": 5,
  "variance_extra_repeats_per_round": 2,
  "maximum_independent_repeats": 9,
  "repeat_median_cv_threshold": 0.15,
  "retry_limit_per_process_run": 1,
  "topology_categories": ["NVLINK_*", "PIX", "PXB", "PHB", "NODE", "SYS"],
