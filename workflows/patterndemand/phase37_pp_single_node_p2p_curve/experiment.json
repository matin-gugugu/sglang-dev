    "tensor allocation",
    "scheduler execution",
    "communication-compute overlap"
  ],
  "backend": "torch.distributed.isend/irecv over NCCL device process group, matching SGLang async send_tensor_dict tensor primitive",
  "dtype": "bfloat16",
  "payload_bytes": [
