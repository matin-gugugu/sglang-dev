  "objective": "测量与SGLang PP异步GPU张量发送原语一致的单机P2P payload-latency连续曲线",
  "required_gpu_count": 2,
  "training_performed": false,
  "model_weights_required": false,
  "measurement_scope": "tensor_only_sender_counted_logical_message",
